{
  "manifest_version": 3,
  "name": "Symbiot",
  "description": "Lets Symbiot work in your own Chrome, on the sites you allow one by one, in a window and tab group of its own.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "tabs", "tabGroups", "scripting", "alarms", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Symbiot", "default_popup": "popup.html" },
  "icons": { "128": "icon.png" }
}

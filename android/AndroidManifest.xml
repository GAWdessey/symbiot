<?xml version="1.0" encoding="utf-8"?>
<!-- targetSdk 28 on purpose: Android only lets an app run programs it unpacked
     into its own files (Node, git, gh here) when it targets 28 or lower, the same
     reason Termux does. That keeps it off the Play Store; it's sideloaded. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="co.symbiot.app">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- your phone's link (phone.mjs): ask your computer again as soon as the network changes -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- your repos in the phone's shared storage: "All files access" on Android 11+,
         the storage permission before that -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:label="Symbiot"
        android:icon="@drawable/ic_symbiot"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:extractNativeLibs="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|smallestScreenSize|density"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- a Symbiot link, as `symbiot app` in Termux opens it
                 (symbiot://127.0.0.1:<port>/?t=<token>, which only this app takes):
                 the app shows that Symbiot here -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="symbiot" android:host="127.0.0.1" />
                <data android:scheme="symbiot" android:host="localhost" />
            </intent-filter>
            <!-- pairing with your computer: the link its QR holds (symbiot.co.za/pair, which
                 the site hands on as symbiot://pair), so the phone's own camera scans it -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="symbiot" android:host="pair" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="symbiot.co.za" android:pathPrefix="/pair" />
            </intent-filter>
            <!-- the same as http://, which Android gives to the browser unless
                 the user lets this app open 127.0.0.1 (App info → Set as default) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:host="127.0.0.1" android:path="/" />
                <data android:scheme="http" android:host="localhost" android:path="/" />
            </intent-filter>
        </activity>

        <service
            android:name=".SymbiotService"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
